{
  "name": "puresv",
  "version": "0.0.2",
  "description": "Pure Svelte 5 UI components styled with modern CSS. No runtime dependencies, no utility-class framework.",
  "keywords": [
    "components",
    "css",
    "design-system",
    "svelte",
    "svelte5",
    "ui"
  ],
  "homepage": "https://puresv.pages.dev",
  "bugs": {
    "url": "https://github.com/4imd3v/puresv/issues"
  },
  "license": "MIT",
  "author": "41m50mn14",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/4imd3v/puresv.git"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "!dist/**/*.test.*",
    "!dist/**/*.spec.*"
  ],
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "types": "./dist/index.d.ts",
  "svelte": "./dist/index.js",
  "imports": {
    "#lib": "./src/lib/index.js",
    "#lib/*": "./src/lib/*"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js"
    },
    "./theme.css": "./dist/theme.css",
    "./package.json": "./package.json"
  },
  "scripts": {
    "dev": "vp dev",
    "build": "vp build && pnpm run prepack",
    "build:docs": "vp build",
    "preview": "vp preview",
    "prepare": "vp config && svelte-kit sync || echo ''",
    "prepack": "svelte-kit sync && svelte-package && publint",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "test": "vp test",
    "test:watch": "vp test --watch"
  },
  "devDependencies": {
    "@google/design.md": "^0.4.0",
    "@sveltejs/adapter-auto": "^8.0.0",
    "@sveltejs/kit": "^3.0.0",
    "@sveltejs/package": "^2.5.8",
    "@sveltejs/vite-plugin-svelte": "^7.2.0",
    "@testing-library/svelte": "^5.4.2",
    "happy-dom": "^21.0.1",
    "publint": "^0.3.21",
    "svelte": "^5.57.1",
    "svelte-check": "^4.6.0",
    "typescript": "^6.0.3",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "peerDependencies": {
    "svelte": "^5.0.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.11.2",
      "onFail": "download"
    }
  }
}
